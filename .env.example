# 未配置时不生成任何 AI 回答。支持 none / openai / deeptutor。
AI_PROVIDER=none
# 标准 OpenAI 兼容 Chat Completions；地址应包含 /v1。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
# 可选 DeepTutor 2.0 协议内部网关；第一版建议接第三方 OpenAI 兼容 API。
DEEPTUTOR_WS_URL=ws://127.0.0.1:8001/ws
DEEPTUTOR_TOKEN=
DATABASE_URL=sqlite:///./data/study.db
# PostgreSQL 可改为 postgresql+psycopg://study:password@127.0.0.1:5432/study
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
API_INTERNAL_URL=http://127.0.0.1:18000
SUPPORT_WAIT_SECONDS=30
SUPPORT_MAX_STATES_PER_TURN=3
# 仅失败/取消后重试同一状态需要间隔；新状态无需全局冷却。
SUPPORT_RETRY_SECONDS=30
# 状态稳定变化后重写原卡，不按摄像头帧调用 AI。
SUPPORT_STATE_STABLE_SECONDS=6
SUPPORT_ERROR_THRESHOLD=2

API_PORT=18000
WEB_PORT=3000

# 页面保存的 AI 配置优先于上方 AI 环境变量；默认只限本机操作。
AI_CONFIG_PATH=./data/ai-connection.json
AI_SETTINGS_ENABLED=true

# Actual pinned adaptive-cognitive-load-analysis engine (local API process).
VISION_ENABLED=true
