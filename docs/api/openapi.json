  "components": {
    "schemas": {
      "AIConnectionUpdate": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "none",
              "openai"
            ],
            "title": "Provider",
            "default": "openai"
          },
          "base_url": {
            "type": "string",
            "maxLength": 2048,
            "title": "Base Url",
            "default": "https://api.openai.com/v1"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "title": "Model",
            "default": ""
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string",
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          },
          "clear_api_key": {
            "type": "boolean",
            "title": "Clear Api Key",
            "default": false
          },
          "timeout_seconds": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Timeout Seconds",
            "default": 45
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AIConnectionUpdate"
      },
      "Activity": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Version"
          },
          "foreground": {
            "type": "boolean",
            "title": "Foreground"
          },
          "has_draft": {
            "type": "boolean",
            "title": "Has Draft"
          },
          "composing": {
            "type": "boolean",
            "title": "Composing"
          },
          "busy": {
            "type": "boolean",
            "title": "Busy"
          },
          "reading": {
            "type": "boolean",
            "title": "Reading"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "foreground",
          "has_draft",
          "composing",
          "busy",
          "reading"
        ],
        "title": "Activity"
      },
      "Answer": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "title": "Text",
            "default": ""
          },
          "event": {
            "type": "string",
            "enum": [
              "message",
              "open",
              "hint",
              "answer",
              "continue",
              "skip"
            ],
            "title": "Event",
            "default": "message"
          },
          "version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Version"
          },
          "request_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "request_id"
        ],
        "title": "Answer"
      },
      "Consent": {
        "properties": {
          "support": {
            "type": "boolean",
            "title": "Support",
            "default": false
          },
          "camera": {
            "type": "boolean",
            "title": "Camera",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Consent"
      },
      "Control": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "open",
              "hint",
              "answer",
              "continue",
              "skip",
              "think",
              "reject",
              "pause",
              "resume",
              "end",
              "correct",
              "consent"
            ],
            "title": "Action"
          },
          "version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Version"
          },
          "text": {
            "type": "string",
            "maxLength": 1000,
            "title": "Text",
            "default": ""
          },
          "consent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Consent"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "version"
        ],
        "title": "Control"
      },
      "CreateSession": {
        "properties": {
          "task_id": {
            "type": "string",
            "enum": [
              "variable",
              "mean",
              "causality"
            ],
            "title": "Task Id"
          },
          "consent": {
            "$ref": "#/components/schemas/Consent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id"
        ],
        "title": "CreateSession"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RenameSession": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80,
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "RenameSession"
      },
      "StreamAnswer": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "title": "Text",
            "default": ""
          },
          "event": {
            "type": "string",
            "enum": [
              "message",
              "open",
              "hint",
              "answer",
              "continue",
              "skip",
              "correct"
            ],
            "title": "Event",
            "default": "message"
          },
          "version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Version"
          },
          "request_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "request_id"
        ],
        "title": "StreamAnswer"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
